# Copy to .env and fill in. Never commit .env.

# --- FXCM (forex + gold) -----------------------------------------------------
# The legacy REST API (api.fxcm.com, api-demo.fxcm.com) no longer exists in DNS as
# of 2026-10-12, and the Trading Station Web access token that it used is therefore
# dead. The current FXCM API is FCLite. See DECISIONS.md D-006.
#
# FCLite authentication uses a normal FXCM trading account (login id + password),
# NOT an API key. Free demo accounts: https://demo.fxcm.app
FXCM_LOGIN_ID=
FXCM_PASSWORD=
# Demo uses endpoints-demo.fxcm.com, a funded live account uses endpoints.fxcm.com.
FXCM_IAM_HOST=endpoints-demo.fxcm.com
# Analysis series from FXCM bid/ask candles: mid | bid | ask
FXCM_PRICE_SIDE=mid
# Legacy fields, kept only so the retired adapter fails with a clear message.
FXCM_ACCESS_TOKEN=
FXCM_HOST=api-demo.fxcm.com

# --- Deriv (synthetic indices) ----------------------------------------------
# Register an app at https://developers.deriv.com (free). Optional: the public
# test app id 1089 works for read-only market data.
# Put the real value in .env only. Never put a credential in this tracked file:
DERIV_APP_ID=
# --- Crypto exchange for CCXT ----------------------------------------------
# bybit | okx | binanceusdm | deribit | ...  No key needed for market data.
CRYPTO_EXCHANGE=deribit

# --- Storage ---------------------------------------------------------------
DB_PATH=data/trading.sqlite3

# --- CoinMarketCap (optional: crypto quotes and rankings for the screener) ---
# Free plan: quotes, listings and metadata. Historical candles are a paid-plan
# endpoint (verified: HTTP 403, error_code 1006 on 2026-10-13). Put the key in .env.
CMC_API_KEY=
